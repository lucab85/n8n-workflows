# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# --- n8n ----------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Losing this key after activating workflows means n8n can no longer decrypt
# any saved credentials — back it up somewhere outside this repo.
N8N_ENCRYPTION_KEY=change-me

# Hostname n8n runs behind (no https://, no trailing slash). For local-only use
# this can be "localhost".
N8N_HOST=localhost
N8N_PROTOCOL=http
# Must match N8N_HOST/N8N_PROTOCOL with a trailing slash — this is what gets
# used to build webhook URLs (e.g. the JAPOW Telegram/location webhooks).
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Rome

# Host port to bind n8n's UI/API to.
N8N_PORT_BINDING=5678

# --- ai-prospect-scout.json ---------------------------------------------------
# Read directly from the environment via {{ $env.APIFY_TOKEN }} in the workflow's
# HTTP Request nodes (not an n8n credential) — apify.com > Settings > Integrations.
APIFY_TOKEN=
# platform.openai.com/api-keys
OPENAI_API_KEY=

# --- podcast-claude-producer.json --------------------------------------------
# Claude API key used by the podcast production-pack workflow.
ANTHROPIC_API_KEY=
# Optional shared secret. When set, callers must send it as x-podcast-token.
PODCAST_WEBHOOK_TOKEN=

# --- blog-to-convertkit.json ---------------------------------------------------
# ConvertKit -> Account Settings -> API Secret (NOT the public API Key — the
# broadcasts endpoint this workflow calls needs the secret one).
CONVERTKIT_API_SECRET=

# --- Everything else is an n8n credential, or a placeholder inside the node ---
# Create credentials from the n8n UI (Credentials > New) after first login, then
# select them in each node that needs them. Anthropic/other API keys that are
# typed directly into an HTTP Request node's header (not read from env) show up
# as YOUR_..._HERE placeholders — find them with: grep -rn YOUR_ workflows/
#
#   ai-prospect-scout.json      -> Google Sheets (OAuth2 or service account)
#   japow-1-powder-watch        -> Telegram, Supabase, Apify (HTTP header auth)
#   japow-2-lock-it-in          -> Telegram, Supabase
#   japow-3-arrival-sequence    -> Telegram, Supabase, RapidAPI (AeroDataBox),
#                                  Bland.ai (HTTP header auth)
#   swell-event.json            -> Telegram, Apify, Bland.ai, RapidAPI (AeroDataBox)
#   surfboard-sniper.json       -> Apify, Supabase, Telegram
#   garmin-claude-coach.json    -> Anthropic (HTTP header auth); Supabase URL
#                                  is a placeholder in the node, not a credential
#   podcast-claude-producer.json -> Anthropic via ANTHROPIC_API_KEY env var
#   blog-to-convertkit.json     -> Google Sheets
#   advisory-lead-qualification.json -> Anthropic (HTTP header auth), Google Sheets
#   speaking-intake.json        -> Google Sheets
#   speaking-reminders.json     -> Google Sheets, SMTP
#
# See README.md for the full per-workflow setup checklist.
