# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# --- n8n ----------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Losing this key after activating workflows means n8n can no longer decrypt
# any saved credentials — back it up somewhere outside this repo.
N8N_ENCRYPTION_KEY=change-me

# Hostname n8n runs behind (no https://, no trailing slash). For local-only use
# this can be "localhost".
N8N_HOST=localhost
N8N_PROTOCOL=http
# Must match N8N_HOST/N8N_PROTOCOL with a trailing slash — this is what gets
# used to build webhook URLs (e.g. the JAPOW Telegram/location webhooks).
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Rome

# Host port to bind n8n's UI/API to.
N8N_PORT_BINDING=5678

# --- ai-prospect-scout.json ---------------------------------------------------
# Read directly from the environment via {{ $env.APIFY_TOKEN }} in the workflow's
# HTTP Request nodes (not an n8n credential) — apify.com > Settings > Integrations.
APIFY_TOKEN=
# platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Everything else is an n8n credential, not an env var ---------------------
# Create these from the n8n UI (Credentials > New) after first login, then
# select them in each node that needs them:
#
#   ai-prospect-scout.json  -> Google Sheets (OAuth2 or service account)
#   japow-1-powder-watch    -> Telegram, Supabase, Apify (HTTP header auth)
#   japow-2-lock-it-in      -> Telegram, Supabase
#   japow-3-arrival-sequence -> Telegram, Supabase, RapidAPI (AeroDataBox),
#                               Bland.ai (HTTP header auth)
#
# See README.md for the full per-workflow setup checklist.
