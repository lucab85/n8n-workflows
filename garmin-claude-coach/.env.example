# Garmin Connect login
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password
# where to cache the login token (optional; default ~/.garminconnect)
# GARMIN_TOKENSTORE=~/.garminconnect

# Supabase (service_role key - server-side only, never ship to a browser)
GARMIN_SUPABASE_URL=https://your-project-ref.supabase.co
GARMIN_SUPABASE_SERVICE_KEY=your-service-role-key
