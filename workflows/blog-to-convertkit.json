    {
      "parameters": {
        "url": "https://lucaberton.com/rss.xml",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "b1000000-0000-0000-0000-000000000003",
      "name": "Fetch RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        480,
        400
      ],
      "notes": "lucaberton.com/rss.xml - verified live, standard RSS 2.0."
    },
    {
      "parameters": {
        "jsCode": "// Regex-parse the RSS <item> blocks - no XML parser dependency needed.\nconst xml = $input.first().json.data || '';\nif (!xml || xml.length < 200) {\n  throw new Error('RSS feed returned ' + xml.length + ' chars - empty or blocked');\n}\nfunction tag(block, name) {\n  const m = block.match(new RegExp('<' + name + '[^>]*>([\\\\s\\\\S]*?)<\\\\/' + name + '>'));\n  if (!m) return '';\n  return m[1]\n    .replace(/^<!\\[CDATA\\[/, '').replace(/\\]\\]>$/, '')\n    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&apos;/g, \"'\")\n    .trim();\n}\nconst items = [...xml.matchAll(/<item>([\\s\\S]*?)<\\/item>/g)].map(m => m[1]);\nif (items.length === 0) {\n  throw new Error('0 <item> blocks found - feed layout may have changed');\n}\nreturn items.map(block => ({\n  json: {\n    title: tag(block, 'title'),\n    link: tag(block, 'link'),\n    guid: tag(block, 'guid') || tag(block, 'link'),\n    description: tag(block, 'description'),\n    pubDate: tag(block, 'pubDate'),\n  }\n}));"
      },
      "id": "b1000000-0000-0000-0000-000000000004",
      "name": "Parse RSS items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "BlogLog",
          "mode": "name"
        }
      },
      "id": "b1000000-0000-0000-0000-000000000005",
      "name": "Read BlogLog",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        700,
        560
      ],
      "notes": "Tab 'BlogLog', colonna 'guid' = elenco dei post gia' processati."
    },
    {
      "parameters": {
        "jsCode": "// Fetch RSS -> Parse RSS items -> Read BlogLog -> (here). So $input is\n// Read BlogLog's rows (the already-processed guids); the actual RSS items\n// to filter live on the Parse RSS items node instead.\nconst seen = new Set($input.all().map(i => i.json.guid).filter(Boolean));\nreturn $('Parse RSS items').all().filter(i => !seen.has(i.json.guid));"
      },
      "id": "b1000000-0000-0000-0000-000000000006",
      "name": "Keep only NEW posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.convertkit.com/v3/broadcasts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  api_secret: $env.CONVERTKIT_API_SECRET,\n  subject: $json.title,\n  content: $json.description + '\\n\\n' + $json.link,\n  public: false\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b1000000-0000-0000-0000-000000000007",
