{
  "id": "5538bc38-8e0a-4330-b775-337035c8831d",
  "name": "JAPOW EVENT - 2. Lock it in",
  "nodes": [
    {
      "parameters": {
        "path": "japow-poll",
        "httpMethod": "POST",
        "options": {}
      },
      "name": "Webhook: Telegram poll_answer",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -140,
        400
      ],
      "id": "8a69bf53-a2d7-483d-9c67-a63325b6247c"
    },
    {
      "parameters": {
        "jsCode": "\n// Telegram sends a poll_answer update when someone taps an option. Option index 0 is\n// \"I'm in\". This replaces the hard-coded opt-in stub - the poll now actually decides.\nconst body = $input.first().json.body || $input.first().json || {};\nconst pa   = body.poll_answer || {};\nconst ids  = pa.option_ids || [];\nconst who  = pa.user || {};\n\nconst isIn = ids.indexOf(0) !== -1;\nreturn [{ json: {\n  optedIn:  isIn,\n  userId:   who.id || null,\n  name:     [who.first_name, who.last_name].filter(Boolean).join(' ') || 'someone',\n  pollId:   pa.poll_id || null,\n  verdict:  isIn ? 'in' : 'depends what work is like',\n} }];\n"
      },
      "name": "Read the vote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        400
      ],
      "id": "ac7c2066-7c1d-457c-adbc-acf3df8e8713"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.optedIn }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Anyone in?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        380,
        400
      ],
      "id": "2fa44271-2e9b-41ce-b1d7-53cb9692265e"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "japow_trips",
        "filterType": "string",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "proposed"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "locked"
            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "name": "Mark the trip locked",
      "type": "n8n-nodes-base.supabase",
