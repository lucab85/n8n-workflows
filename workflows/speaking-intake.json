        "jsCode": "const b = $input.first().json.body || $input.first().json || {};\nconst conference = String(b.conference || '').trim();\nif (!conference) throw new Error('missing conference name - got keys: ' + Object.keys(b).join(','));\nreturn [{ json: {\n  conference,\n  event_date: String(b.event_date || '').trim(),\n  cfp_deadline: String(b.cfp_deadline || '').trim(),\n  notes: String(b.notes || '').trim(),\n  status: 'NEW',\n  logged_at: new Date().toISOString(),\n} }];"
