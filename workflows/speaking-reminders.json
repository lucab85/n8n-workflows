    {
      "parameters": {
        "jsCode": "// Remind for anything still NEW whose CFP deadline is within the next 7 days\n// (including already-overdue ones - better a late nudge than none).\nconst MSDAY = 86400000;\nconst now = Date.now();\nconst horizon = now + 7 * MSDAY;\nreturn $input.all().filter(item => {\n  const r = item.json;\n  if (String(r.status || '').trim().toUpperCase() !== 'NEW') return false;\n  const d = Date.parse(r.cfp_deadline);\n  if (isNaN(d)) return false;\n  return d <= horizon;\n});"
      },
      "id": "e4000000-0000-0000-0000-000000000004",
      "name": "Due within 7 days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "YOUR_FROM_EMAIL@example.com",
        "toEmail": "YOUR_EMAIL@example.com",
        "subject": "=CFP reminder: {{ $json.conference }}",
        "emailFormat": "text",
        "text": "=Scadenza CFP: {{ $json.cfp_deadline }}\nEvento: {{ $json.event_date }}\nNote: {{ $json.notes }}\n\n(promemoria automatico dal foglio Speaking)",
